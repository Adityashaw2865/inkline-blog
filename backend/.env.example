# Rename this file to ".env" and fill in real values.
# Never commit the actual .env file to GitHub (it's already in .gitignore).

PORT=5000

# Your MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/inkline-blog

# Secret key used to sign JWT tokens — use any long random string
JWT_SECRET=your_super_secret_key_here
